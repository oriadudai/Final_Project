# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# Virtual environments
venv/
.env/
conda-env/

# Model checkpoints — large binaries, download separately
# (except the PTB-XL diagnostic classifier: small, needed for calibration
# diagnostics, and not separately downloadable; and the arch_reheartnet
# fold checkpoints: the third calib-3way model, trained via run_cv.py and
# saved to this fixed path rather than under results/comparison_reheartnet_optunalr/)
checkpoints/*
!checkpoints/ptbxl_diagnostic_classifier.pt
!checkpoints/reheartnet_fold_*_best.pt
*.pt
*.pth
*.ckpt
!checkpoints/ptbxl_diagnostic_classifier.pt
!checkpoints/reheartnet_fold_*_best.pt

# CLEF external repo — nested git repo, not tracked here.
# Clone and install manually: see README Step 0 / environment.yml
models/clef_repo/
# CLEF pretrained weights — download from Zenodo (see README)
models/clef/

# Generated experiment outputs
# (except results/comparison_reheartnet_optunalr/: the Optuna-lr
# reheartnet_original/reheartnet_huber checkpoints + summaries the main
# report's headline result is built on, not just a regenerable byproduct)
results/*
!results/comparison_reheartnet_optunalr/
!results/comparison_reheartnet_optunalr/**

# Weights & Biases local runs
wandb/

# Optuna SQLite study database
*.db

# Graphify — generated code map (rebuild with: graphify update .)
graphify-out/

# Reference papers downloaded for reading at repo root — not project outputs.
# (Final Report/references.bib has the actual citations; these are just local
# copies for reading, re-download as needed rather than tracking them here.)
/*.pdf

# Stray local run logs at repo root (not the per-script logs under results/,
# which are already excluded by the results/ rule above)
/*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
